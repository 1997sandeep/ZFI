@EndUserText.label: 'Service Definition - LC BG Screen'
define service ZFI_LC_BG_SCREEN_SD {
  expose ZFI_INWARD_LC_CDS       as VendorLC;
  expose ZFI_LC_REQ_DOC_CDS      as ReqDoc;
  expose ZFI_ILC_BOE_CDS         as BOE;
  expose ZFI_LC_COMPCODE_F4      as CompanyCodeF4;
  expose ZFI_OUTWARD_CUSTOMER_F4 as CustomerF4;
  expose ZFI_LC_SUPPLIER_F4      as VendorF4;
  expose ZFI_LC_BANK_F4          as BankF4;
  expose ZFI_LC_NETAMT_F4        as POF4;
  expose ZFI_OUTWARD_BANK        as BankData;
  expose ZFI_CUST_BG_BANK_F4     as bank_data;
}