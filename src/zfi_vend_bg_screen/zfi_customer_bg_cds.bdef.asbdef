    Zbgclaimdate      = zbgclaimdate;
    Zbgextupto        = zbgextupto;
    Bgclaimperiod     = bgclaimperiod;
    Zbgdaysextended   = zbgdaysextended;
    Zbgoverdue        = zbgoverdue;
    Zbgtennure        = zbgtennure;
    Zbgmargin         = zbgmargin;
    Zbgmarginamt      = zbgmarginamt;
    Zcommrate = zcommrate;
    Zcommbasis = zcommbasis;
    Zcommamount = zcommamount;
    Znitdate = znitdate;
    Znitno = znitno;
    Zbgissuanceamt    = zbgissuanceamt;
    Zbgsfmsbgamt      = zbgsfmsbgamt;
