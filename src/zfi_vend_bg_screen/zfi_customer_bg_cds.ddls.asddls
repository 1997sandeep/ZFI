@AccessControl.authorizationCheck: #NOT_REQUIRED
@EndUserText.label: 'Customer BG Monitoring'
@Metadata.ignorePropagatedAnnotations: true
define root view entity ZFI_CUSTOMER_BG_CDS
  as select from zfi_customer_bg
{
  key zslno                    as Zslno,
  key zbgextensionversion      as Zbgextensionversion,
  key zbgclaimextensionversion as Zbgclaimextensionversion,
      zconcernperson           as Zconcernperson,
      zjobnumber               as Zjobnumber,
      zprofitcenter            as Zprofitcenter,
      zbeneficiarycode         as Zbeneficiarycode,
      zbeneficiaryname         as Zbeneficiaryname,
      zbgnumber                as Zbgnumber,
      zbgpurpose               as Zbgpurpose,
      zbgtype                  as Zbgtype,
      zbgamount                as Zbgamount,
      zcreatedon               as Zcreatedon,
      zbgissuancedate          as Zbgissuancedate,
      zbgexpirydate            as Zbgexpirydate,
      zbgclaimdate             as Zbgclaimdate,
      zbgextupto               as Zbgextupto,
      bgclaimperiod            as Bgclaimperiod,
      zbgdaysextended          as Zbgdaysextended,
      zbgoverdue               as Zbgoverdue,
      zbgtennure               as Zbgtennure,
      zbgmargin                as Zbgmargin,
      zbgmarginamt             as Zbgmarginamt,
      zbgissuanceamt           as Zbgissuanceamt,
      zbgsfmsbgamt             as Zbgsfmsbgamt,
      zbgstampamt              as Zbgstampamt,
      zbggstamt                as Zbggstamt,
      zbgtotalchg              as Zbgtotalchg,
      zbgstatus                as Zbgstatus,
      zbgremarks               as Zbgremarks,
      flagcu                   as Flagcu,
      flag                     as Flag,
      zcommrate                as Zcommrate,
      zcommbasis               as Zcommbasis,
      zcommamount              as Zcommamount,
      zcontractno              as Zcontractno,
      zcustomername            as Zcustomername,
      zcustomercode            as Zcustomercode,
      znitno                   as Znitno,
      znitdate                 as Znitdate,
      zbgtenuredays            as Zbgtenuredays,
      zbgtenuremonths          as Zbgtenuremonths,
      zbankifsc                as Zbankifsc,
      zbankname                as Zbankname,
      zbankaddr                as Zbankaddr,
      zcustomerbankifsc        as Zcustomerbankifsc,
      zcustomerbankname        as Zcustomerbankname,
      zcustomerbankaddr        as Zcustomerbankaddr,
      zgstcommamt              as Zgstcommamt,
      zendorsement             as Zendorsement,
      zonerous                 as Zonerous,
      ztenderbenefic           as Ztenderbenefic,
         zotherrate          as Zotherrate,
      zotheramount        as Zotheramount,
      bg_currency as BGcurrency,
          zdms                          as DMS,
          zfile                         as FileNo,
          zmimetype                     as MimeType,
          zfilename                     as FileName,
      createdon                as Createdon,
      createdat                as Createdat,
      createdby                as Createdby,
      changedon                as Changedon,
      changedat                as Changedat,
      changedby                as Changedby,
      lastchanged              as Lastchanged
}
